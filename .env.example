# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
# Example: 6789012345:ABCdefGhIJKlmNoPQRsTUVwxyZ123456789
VITE_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Get your chat ID from @userinfobot or from getUpdates API
# For groups: starts with -100 (example: -1001234567890)
# For personal: just the user ID (example: 123456789)
VITE_TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE
